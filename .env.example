# Public Firebase web application configuration (not GEMINI_API_KEY).
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
# Use npm run dev:firebase for demo-gratitude on local emulators.
# Public reCAPTCHA Enterprise site key; required for live AI.
VITE_FIREBASE_APPCHECK_SITE_KEY=
# generic sends no journal text, preferences or feedback to Gemini.
# paid requires a billing-linked Gemini project before private personalization.
VITE_AI_DATA_MODE=generic
