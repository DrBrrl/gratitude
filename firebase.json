{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 19099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 18080
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 19199
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "functions": {
      "host": "127.0.0.1",
      "port": 15001
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "gratitude-push",
      "runtime": "nodejs24",
      "ignore": [
        "node_modules",
        ".git",
        "*-debug.log",
        ".secret.local",
        ".env",
        ".env.*"
      ]
    }
  ]
}
