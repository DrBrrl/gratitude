rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function validId(id) { return id is string && id.matches('^[a-zA-Z0-9_-]{1,80}$'); }
    // One-time private input prepared by an account administrator. The upgraded
    // client appends these literal questions to its canonical source stream.
    match /users/{uid}/backupPromptImports/{id} {
      allow read: if owns(uid);
      allow write: if false;
    }
    // Revocable credentials are mutable and separate from journal events/exports.
    match /users/{uid}/privateSettings/lmStudio {
      allow get, delete: if owns(uid);
      allow list: if false;
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasAll(['schemaVersion','baseUrl','model','token','updatedAt'])
        && request.resource.data.keys().hasOnly(['schemaVersion','baseUrl','model','token','updatedAt'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.token is string && request.resource.data.token.size() > 0
        && request.resource.data.token.size() <= 4096 && !request.resource.data.token.matches('[\\s\\S]*[\\r\\n][\\s\\S]*')
        && request.resource.data.baseUrl is string && request.resource.data.baseUrl.size() <= 2048
        && request.resource.data.baseUrl.matches('^(https://[^/?#@\\s]+|http://(127\\.0\\.0\\.1|localhost|\\[::1\\])(:[0-9]{1,5})?)$')
        && request.resource.data.model is string
        && request.resource.data.model.matches('^[a-zA-Z0-9][a-zA-Z0-9_.:/@+-]{0,79}$');
    }
    match /users/{uid}/streams/{generation} {
      function root() { return /databases/$(database)/documents/users/$(uid)/streams/$(generation); }
      function eventPath(id) { return /databases/$(database)/documents/users/$(uid)/streams/$(generation)/events/$(id); }
      function pointerPath(id) { return /databases/$(database)/documents/users/$(uid)/streams/$(generation)/entries/$(id); }
      function nextSequence() { let head = get(root()); return head == null ? 1 : head.data.sequence + 1; }
      function nextRevision(entryId) {
        return exists(pointerPath(entryId))
          ? get(eventPath(get(pointerPath(entryId)).data.lastEventId)).data.payload.expectedRevision + 1 : 0;
      }
      allow read: if owns(uid);
      allow create, update: if owns(uid) && generation == 'v1'
        && request.resource.data.keys().hasOnly(['sequence', 'lastEventId'])
        && validId(request.resource.data.lastEventId)
        && request.resource.data.sequence == nextSequence()
        && !exists(eventPath(request.resource.data.lastEventId))
        && getAfter(eventPath(request.resource.data.lastEventId)).data.sequence == request.resource.data.sequence;
      allow delete: if false;
      function aiPath() { return /databases/$(database)/documents/users/$(uid)/streams/$(generation)/ai/control; }
      function aiBefore() { return exists(aiPath()) ? get(aiPath()).data : {'lastEventId': null, 'choicesId': null, 'requestId': null}; }
      function validDay(day) { return day is string && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
      function text(value, max) { return value is string && value.size() <= max; }
      function importPath(key) { return /databases/$(database)/documents/users/$(uid)/streams/$(generation)/imports/$(key); }
      function entryHasText(entryId) {
        let e = get(eventPath(get(pointerPath(entryId)).data.lastEventId)).data;
        return e.type == 'ReflectionImported' ? e.payload.photoSlot == null : e.payload.text.matches('[\\s\\S]*[^\\s][\\s\\S]*');
      }
      function promptId(e) { return e.schemaVersion == 1 ? e.payload.starterId : e.payload.promptId; }
      function knownPrompt(id) { return id == 'small-moment-v1' || (validId(id) && (get(eventPath(id)).data.type in ['PromptResponseReceived', 'ImportRecordConfirmed', 'BackupPromptImported'] || get(eventPath(id)).data.type == 'ReflectionWritten' && get(eventPath(id)).data.schemaVersion in [5, 6] && get(eventPath(id)).data.payload.promptText is string && get(eventPath(id)).data.payload.promptId == id)); }
      function unchangedEntryDate(e) {
        let previous = exists(pointerPath(e.payload.entryId)) ? get(eventPath(get(pointerPath(e.payload.entryId)).data.lastEventId)).data : e;
        return e.schemaVersion == 6 || (e.schemaVersion in [3, 4, 5]
          ? e.payload.entryAt == previous.payload.get('entryAt', null)
          : previous.payload.get('entryAt', null) == null);
      }
      function validReflection(e) {
        let p = e.payload;
        return e.type == 'ReflectionWritten'
          && ((e.schemaVersion == 1 && p.keys().hasOnly(['entryId', 'text', 'expectedRevision', 'starterId']) && p.starterId == 'small-moment-v1')
            || (e.schemaVersion == 2 && p.keys().hasOnly(['entryId', 'text', 'expectedRevision', 'promptId']) && knownPrompt(p.promptId))
            || (e.schemaVersion == 3 && p.keys().hasOnly(['entryId', 'text', 'expectedRevision', 'promptId', 'entryAt'])
              && knownPrompt(p.promptId) && p.entryAt is timestamp && p.entryAt <= request.time)
            || (e.schemaVersion in [5, 6] && p.keys().hasOnly(['entryId', 'text', 'expectedRevision', 'promptId', 'promptText', 'entryAt', 'photoSlot'])
              && ((p.promptText == null && knownPrompt(p.promptId)) || (p.promptId == e.eventId && text(p.promptText, 600) && p.promptText.matches('[\\s\\S]*[^\\s][\\s\\S]*')))
              && (p.entryAt == null || p.entryAt is timestamp && p.entryAt <= request.time)
              && (p.photoSlot == null || p.photoSlot is int && p.photoSlot >= 0 && p.photoSlot < 4))
            || (e.schemaVersion == 4 && p.keys().hasOnly(['entryId', 'text', 'expectedRevision', 'promptId', 'entryAt', 'photoSlot'])
              && knownPrompt(p.promptId) && (p.entryAt == null || p.entryAt is timestamp && p.entryAt <= request.time)
              && (p.photoSlot == null || p.photoSlot is int && p.photoSlot >= 0 && p.photoSlot < 4)))
          && (e.schemaVersion == 6 || !exists(pointerPath(p.entryId)) || get(pointerPath(p.entryId)).data.get('importId', null) == null)
          && unchangedEntryDate(e)
          && validId(p.entryId) && text(p.text, 10000)
          && (p.text.matches('[\\s\\S]*[^\\s][\\s\\S]*') || e.schemaVersion in [4, 5, 6] && p.photoSlot is int && activePhoto(p.entryId, p.photoSlot))
          && p.expectedRevision is int && p.expectedRevision == nextRevision(p.entryId)
          && (e.schemaVersion in [5, 6] || !exists(pointerPath(p.entryId)) || promptId(e) == promptId(get(eventPath(get(pointerPath(p.entryId)).data.lastEventId)).data))
          && getAfter(pointerPath(p.entryId)).data.lastEventId == e.eventId;
      }
      function validRef(ref) { return ref is map && ref.keys().hasOnly(['entryId', 'revision']) && validId(ref.entryId) && ref.revision is int && ref.revision > 0; }
      function validRefs(refs) {
        return (refs.size() < 1 || validRef(refs[0])) && (refs.size() < 2 || validRef(refs[1]))
          && (refs.size() < 3 || validRef(refs[2])) && (refs.size() < 4 || validRef(refs[3])) && (refs.size() < 5 || validRef(refs[4]));
      }
      function validRefMap(refs) {
        // Map keys enforce uniqueness. Typed round-trip equality rejects join coercion
        // and embedded separators without unrolling twenty checks in the Rules budget.
        let tail = '{' + string(refs.size() - 1) + '}';
        let values = refs.values();
        let joined = values.join(' ');
        return refs.size() == 0 || joined.split(' ') == values
          && refs.keys().join(' ').matches('^[a-zA-Z0-9_-]{1,80}( [a-zA-Z0-9_-]{1,80})' + tail + '$')
          && joined.matches('^[1-9][0-9]{0,14}( [1-9][0-9]{0,14})' + tail + '$');
      }
      function validFeedbackIds(ids) {
        let joined = ids.join(' ');
        return ids.size() == 0 || joined.split(' ') == ids
          && joined.matches('^[a-zA-Z0-9_-]{1,80}( [a-zA-Z0-9_-]{1,80}){' + string(ids.size()-1) + '}$');
      }
      function validLocal(p) { return p.provider == 'lm-studio' && p.thinking == false && p.model is string && p.model.matches('^[a-zA-Z0-9][a-zA-Z0-9_.:/@+-]{0,79}$'); }
      function validRequest(p, before, schema) {
        let choices = get(eventPath(before.choicesId)).data.payload;
        let mixed = schema in [3,4,5,6,7,8];
        let editor = schema in [2,4,6];
        let local = schema in [5,6,8];
        return p.keys().hasOnly(['previousEventId', 'choicesId', 'day', 'templateVersion', 'contextMode', 'entryRefs', 'feedbackIds'].concat(editor ? ['entryId', 'entryRevision'] : []).concat(mixed ? ['selectorVersion','timeZone','selectionSeed'] : []).concat(local ? ['provider','model','thinking'] : []).concat(schema in [7,8] ? ['purpose'] : []))
          && (!(schema in [7,8]) || p.purpose == 'backup' && choices.get('backupEnabled',false) == true && (before.requestId == null || request.time > get(eventPath(before.requestId)).data.recordedAt + duration.value(180,'s')))
          && (!local || validLocal(p)) && (!(editor) || validId(p.entryId) && p.entryRevision is int && p.entryRevision == nextRevision(p.entryId))
          && p.choicesId == before.choicesId && choices.enabled == true
          && (schema in [7,8] ? choices.get('backupProvider','lm-studio') : choices.get('provider','gemini')) == (local ? 'lm-studio' : 'gemini') && validDay(p.day)
          && p.templateVersion in ['gratitude-v1', 'gratitude-v2'] && p.contextMode in ['generic', 'personal']
          && (!(mixed) || p.selectorVersion == 'mixed-v1' && p.timeZone is string && p.timeZone.size() <= 100 && p.timeZone.matches('^[A-Za-z_+-]+(/[A-Za-z0-9_+-]+)*$') && p.selectionSeed is string && p.selectionSeed.matches('^[a-f0-9]{32}$'))
          && (mixed ? p.entryRefs is map && p.entryRefs.size() <= 20 && validRefMap(p.entryRefs) : p.entryRefs is list && p.entryRefs.size() <= 5 && validRefs(p.entryRefs)) && p.feedbackIds is list && p.feedbackIds.size() <= 20
          && (p.feedbackIds.size() == 0 || p.feedbackIds.toSet().size() == p.feedbackIds.size() && validFeedbackIds(p.feedbackIds))
          && (p.contextMode != 'generic' || (p.entryRefs.size() == 0 && p.feedbackIds.size() == 0))
          && (choices.useJournal || p.entryRefs.size() == 0) && (choices.useFeedback || p.feedbackIds.size() == 0);
      }
      function validAI(e) {
        let p = e.payload;
        let before = aiBefore();
        let after = getAfter(aiPath()).data;
        let result = e.type in ['PromptResponseReceived', 'AIRequestFailed'];
        return (e.schemaVersion == 1 || e.type == 'AIChoicesConfirmed' && e.schemaVersion in [2,3] || e.type == 'PromptRequested' && e.schemaVersion in [2,3,4,5,6,7,8]) && after.lastEventId == e.eventId
          && after.choicesId == (e.type == 'AIChoicesConfirmed' ? e.eventId : before.choicesId)
          && after.requestId == (e.type == 'PromptRequested' ? e.eventId : e.type == 'PromptFeedbackSubmitted' ? before.requestId : null)
          && (result ? validId(p.requestId) && p.requestId == before.requestId : p.previousEventId == before.lastEventId)
          && (
            (e.type == 'AIChoicesConfirmed' && p.keys().hasOnly(['previousEventId', 'enabled', 'useJournal', 'useFeedback', 'guidance'].concat(e.schemaVersion in [2,3] ? ['provider'] : []).concat(e.schemaVersion == 3 ? ['backupEnabled','backupProvider'] : []))
              && (!(e.schemaVersion in [2,3]) || p.provider in ['gemini','lm-studio']) && (e.schemaVersion != 3 || p.backupEnabled is bool && p.backupProvider in ['gemini','lm-studio'])
              && p.enabled is bool && p.useJournal is bool && p.useFeedback is bool && text(p.guidance, 500))
            || (e.type == 'PromptRequested' && validRequest(p, before, e.schemaVersion))
            || (e.type == 'PromptResponseReceived' && p.keys().hasOnly(['requestId', 'text', 'model', 'finishReason'])
              && e.eventId == p.requestId + '_response' && text(p.text, 600) && p.text.matches('[\\s\\S]*[^\\s][\\s\\S]*')
              && text(p.model, 100) && p.model.size() > 0 && p.finishReason == 'STOP')
            || (e.type == 'AIRequestFailed' && p.keys().hasOnly(['requestId', 'reason'])
              && e.eventId == p.requestId + '_failure' && p.reason in ['unavailable', 'blocked', 'invalid-response'])
            || (e.type == 'PromptFeedbackSubmitted' && p.keys().hasOnly(['previousEventId', 'promptId', 'text']) && knownPrompt(p.promptId) && text(p.text, 500))
            || (e.type == 'StarterPromptChosen' && p.keys().hasOnly(['previousEventId', 'day', 'starterId']) && validDay(p.day) && p.starterId == 'small-moment-v1')
          );
      }

      function backupPath(id) {return /databases/$(database)/documents/users/$(uid)/streams/$(generation)/backups/$(id);}
      function validBackup(e) {
        let p=e.payload;
        let id=e.type == 'BackupPromptImported' ? e.eventId : p.promptId;
        return e.schemaVersion == 1 && getAfter(backupPath(id)).data.lastEventId == e.eventId &&
          (e.type == 'BackupPromptImported' ? p.keys().hasAll(['text']) && p.keys().hasOnly(['text']) && e.eventId.matches('^bp_[a-f0-9]{64}$') && text(p.text,600) && p.text.matches('[\\s\\S]*[^\\s][\\s\\S]*')
          : e.type == 'BackupPromptRemoved' && p.keys().hasAll(['promptId']) && p.keys().hasOnly(['promptId']) && validId(p.promptId) && (exists(backupPath(p.promptId)) || get(eventPath(p.promptId)).data.type == 'PromptResponseReceived' && get(eventPath(get(eventPath(p.promptId)).data.payload.requestId)).data.schemaVersion in [7,8]));
      }
      function photoPath(entryId, slot) { return /databases/$(database)/documents/users/$(uid)/streams/$(generation)/photos/$(entryId + '_' + string(slot)); }
      function photoBefore(entryId, slot) { let pointer = get(photoPath(entryId, slot)); return pointer == null ? null : get(eventPath(pointer.data.lastEventId)).data; }
      function activePhoto(entryId, slot) { let event = photoBefore(entryId, slot); return event != null && event.type != 'PhotoRemoved'; }
      function otherPhoto(entryId, slot) { return (slot != 0 && activePhoto(entryId, 0)) || (slot != 1 && activePhoto(entryId, 1)) || (slot != 2 && activePhoto(entryId, 2)) || (slot != 3 && activePhoto(entryId, 3)); }
      function currentProvider() { let control=aiBefore(); return control.choicesId == null ? 'gemini' : get(eventPath(control.choicesId)).data.payload.get('provider','gemini'); }
      function validPhoto(e) {
        let p = e.payload;
        let old = photoBefore(p.entryId, p.slot);
        let extras = e.type == 'PhotoSummaryRequested' && e.schemaVersion == 2 ? ['provider','model','thinking'] : e.type == 'PhotoSummaryEdited' ? ['text'] : e.type == 'PhotoSummaryResponseReceived' ? ['text', 'model', 'finishReason'] : e.type == 'PhotoSummaryFailed' ? ['reason'] : [];
        return (e.schemaVersion == 1 || e.type == 'PhotoSummaryRequested' && e.schemaVersion == 2 && validLocal(p)) && validId(p.entryId) && validId(p.photoId) && p.slot is int && p.slot >= 0 && p.slot < 4
          && p.keys().hasOnly(['entryId', 'slot', 'photoId', 'previousEventId'].concat(extras))
          && (e.type != 'PhotoSummaryRequested' || currentProvider() == (e.schemaVersion == 2 ? 'lm-studio' : 'gemini'))
          && p.previousEventId == (old == null ? null : old.eventId)
          && getAfter(photoPath(p.entryId, p.slot)).data.lastEventId == e.eventId
          && (e.type == 'PhotoAttached' ? old == null || old.type == 'PhotoRemoved'
            : old != null && old.type != 'PhotoRemoved' && p.photoId == old.payload.photoId)
          && (e.type == 'PhotoAttached' || e.type == 'PhotoSummaryRequested'
            || (e.type == 'PhotoRemoved' && (!exists(pointerPath(p.entryId)) || entryHasText(p.entryId) || otherPhoto(p.entryId, p.slot)))
            || (e.type == 'PhotoSummaryEdited' && text(p.text, 1000))
            || (e.type == 'PhotoSummaryResponseReceived' && old.type == 'PhotoSummaryRequested' && e.eventId == p.previousEventId + '_response'
              && text(p.text, 1000) && p.text.matches('[\\s\\S]*[^\\s][\\s\\S]*') && text(p.model, 100) && p.model.size() > 0 && p.finishReason == 'STOP')
            || (e.type == 'PhotoSummaryFailed' && old.type == 'PhotoSummaryRequested' && e.eventId == p.previousEventId + '_failure' && p.reason in ['unavailable', 'blocked', 'invalid-response']));
      }
      function optionalText(value, max) { return value == null || text(value, max); }
      function validSource(s) {
        return s is map && s.keys().hasAll(['id','noteId','noteText','createdOn','createdOnStr','updatedOn','updatedOnStr','noteColor','imagePath','driveImagePath','addressTo','prompt','promptId','moodId','backgroundId'])
          && s.keys().hasOnly(['id','noteId','noteText','createdOn','createdOnStr','updatedOn','updatedOnStr','noteColor','imagePath','driveImagePath','addressTo','prompt','promptId','moodId','backgroundId'])
          && s.id is int && s.id >= 0 && text(s.noteId, 80) && s.noteId.size() > 0 && text(s.noteText, 10000)
          && s.createdOn is int && s.createdOn >= 0 && s.updatedOn is int && s.updatedOn >= s.createdOn && s.updatedOn <= request.time.toMillis()
          && text(s.createdOnStr, 40) && text(s.updatedOnStr, 40) && s.noteColor is string && s.noteColor.matches('^#[0-9a-fA-F]{6}$')
          && optionalText(s.imagePath,512) && optionalText(s.driveImagePath,512) && text(s.addressTo,500)
          && (s.prompt == null || text(s.prompt,600) && s.prompt.matches('[\\s\\S]*[^\\s][\\s\\S]*'))
          && optionalText(s.promptId,80) && optionalText(s.moodId,80) && optionalText(s.backgroundId,80);
      }
      function sourceHasPhoto(s) { return s.imagePath != null && s.imagePath != '' || s.driveImagePath != null && s.driveImagePath != ''; }
      function validImport(e) {
        let p = e.payload;
        return e.schemaVersion == 1 && p.sourceKey is string && p.sourceKey.matches('^[a-f0-9]{64}$')
          && p.entryId == 'e_' + p.sourceKey
          && (e.type == 'ImportRecordConfirmed'
            ? p.keys().hasAll(['format','sourceKey','entryId','source','attachments']) && p.keys().hasOnly(['format','sourceKey','entryId','source','attachments'])
              && e.eventId == 'ic_' + p.sourceKey && p.format == 'alternate-gratitude-zip-v1' && validSource(p.source)
              && p.attachments is list && p.attachments.size() == (sourceHasPhoto(p.source) ? 1 : 0)
              && (p.attachments.size() == 0 || p.attachments[0] is map && p.attachments[0].keys().hasAll(['photoId','sourceDigest']) && p.attachments[0].keys().hasOnly(['photoId','sourceDigest']) && validId(p.attachments[0].photoId) && p.attachments[0].sourceDigest is string && p.attachments[0].sourceDigest.matches('^[a-f0-9]{64}$'))
              && (p.source.noteText.matches('[\\s\\S]*[^\\s][\\s\\S]*') || p.attachments.size() > 0)
              && !exists(importPath(p.sourceKey)) && !exists(pointerPath(p.entryId))
              && getAfter(importPath(p.sourceKey)).data.confirmationId == e.eventId && getAfter(importPath(p.sourceKey)).data.lastEventId == e.eventId
            : validImportCompletion(e));
      }
      function validImportCompletion(e) {
        let p = e.payload;
        let receipt = get(importPath(p.sourceKey)).data;
        let confirmed = get(eventPath(p.confirmationId)).data;
        let input = confirmed.payload;
        return e.type == 'ReflectionImported' && e.eventId == 'iw_' + p.sourceKey
          && p.keys().hasAll(['sourceKey','confirmationId','entryId','expectedRevision','photoSlot']) && p.keys().hasOnly(['sourceKey','confirmationId','entryId','expectedRevision','photoSlot'])
          && p.confirmationId == 'ic_' + p.sourceKey && p.expectedRevision == 0 && !exists(pointerPath(p.entryId))
          && receipt.confirmationId == p.confirmationId && receipt.lastEventId == p.confirmationId
          && confirmed.type == 'ImportRecordConfirmed' && input.sourceKey == p.sourceKey && input.entryId == p.entryId
          && p.photoSlot == (input.source.noteText.matches('[\\s\\S]*[^\\s][\\s\\S]*') ? null : 0)
          && (input.attachments.size() == 0 || activePhoto(p.entryId,0) && photoBefore(p.entryId,0).payload.photoId == input.attachments[0].photoId)
          && getAfter(importPath(p.sourceKey)).data.confirmationId == p.confirmationId && getAfter(importPath(p.sourceKey)).data.lastEventId == e.eventId
          && getAfter(pointerPath(p.entryId)).data.lastEventId == e.eventId && getAfter(pointerPath(p.entryId)).data.importId == p.confirmationId;
      }
      match /events/{eventId} {
        allow read: if owns(uid);
        allow create: if owns(uid) && generation == 'v1' && validId(eventId)
          && request.resource.data.keys().hasOnly(['eventId', 'type', 'schemaVersion', 'payload', 'sequence', 'recordedAt'])
          && request.resource.data.eventId == eventId && request.resource.data.recordedAt == request.time
          && request.resource.data.sequence == nextSequence()
          && getAfter(root()).data.sequence == request.resource.data.sequence && getAfter(root()).data.lastEventId == eventId
          && (request.resource.data.type in ['BackupPromptImported','BackupPromptRemoved'] ? validBackup(request.resource.data) : request.resource.data.type in ['ImportRecordConfirmed','ReflectionImported'] ? validImport(request.resource.data) : request.resource.data.type == 'ReflectionWritten' ? validReflection(request.resource.data) : request.resource.data.type.matches('Photo.*') ? validPhoto(request.resource.data) : validAI(request.resource.data));
        allow update, delete: if false;
      }
      match /ai/{id} {
        allow read: if owns(uid);
        allow create, update: if owns(uid) && generation == 'v1' && id == 'control'
          && request.resource.data.keys().hasOnly(['lastEventId', 'choicesId', 'requestId'])
          && validId(request.resource.data.lastEventId) && !exists(eventPath(request.resource.data.lastEventId))
          && getAfter(eventPath(request.resource.data.lastEventId)).data.type in ['AIChoicesConfirmed', 'PromptRequested', 'PromptResponseReceived', 'AIRequestFailed', 'PromptFeedbackSubmitted', 'StarterPromptChosen'];
        allow delete: if false;
      }
      match /backups/{id} {
        allow read: if owns(uid);
        allow create, update: if owns(uid) && generation == 'v1' && validId(id) && request.resource.data.keys().hasAll(['lastEventId']) && request.resource.data.keys().hasOnly(['lastEventId']) && !exists(eventPath(request.resource.data.lastEventId))
          && (getAfter(eventPath(request.resource.data.lastEventId)).data.type == 'BackupPromptImported' && id == request.resource.data.lastEventId || getAfter(eventPath(request.resource.data.lastEventId)).data.type == 'BackupPromptRemoved' && getAfter(eventPath(request.resource.data.lastEventId)).data.payload.promptId == id);
        allow delete: if false;
      }
      match /photos/{photoKey} {
        allow read: if owns(uid);
        allow create, update: if owns(uid) && generation == 'v1'
          && request.resource.data.keys().hasOnly(['lastEventId']) && validId(request.resource.data.lastEventId)
          && !exists(eventPath(request.resource.data.lastEventId))
          && getAfter(eventPath(request.resource.data.lastEventId)).data.type.matches('Photo.*')
          && photoKey == getAfter(eventPath(request.resource.data.lastEventId)).data.payload.entryId + '_' + string(getAfter(eventPath(request.resource.data.lastEventId)).data.payload.slot);
        allow delete: if false;
      }
      match /imports/{sourceKey} {
        allow read: if owns(uid);
        allow create, update: if owns(uid) && generation == 'v1'
          && request.resource.data.keys().hasAll(['confirmationId','lastEventId']) && request.resource.data.keys().hasOnly(['confirmationId','lastEventId'])
          && validId(request.resource.data.lastEventId) && !exists(eventPath(request.resource.data.lastEventId))
          && (resource == null
            ? request.resource.data.confirmationId == request.resource.data.lastEventId && getAfter(eventPath(request.resource.data.lastEventId)).data.type == 'ImportRecordConfirmed'
            : resource.data.lastEventId == resource.data.confirmationId && request.resource.data.confirmationId == resource.data.confirmationId && getAfter(eventPath(request.resource.data.lastEventId)).data.type == 'ReflectionImported')
          && getAfter(eventPath(request.resource.data.lastEventId)).data.payload.sourceKey == sourceKey;
        allow delete: if false;
      }
      match /entries/{entryId} {
        allow read: if owns(uid);
        allow create, update: if owns(uid) && generation == 'v1' && validId(entryId)
          && request.resource.data.keys().hasAll(['lastEventId']) && request.resource.data.keys().hasOnly(['lastEventId','importId'])
          && validId(request.resource.data.lastEventId) && !exists(eventPath(request.resource.data.lastEventId))
          && getAfter(eventPath(request.resource.data.lastEventId)).data.type in ['ReflectionWritten','ReflectionImported']
          && getAfter(eventPath(request.resource.data.lastEventId)).data.payload.entryId == entryId
          && (getAfter(eventPath(request.resource.data.lastEventId)).data.type == 'ReflectionImported'
            ? resource == null && request.resource.data.importId == getAfter(eventPath(request.resource.data.lastEventId)).data.payload.confirmationId
            : (resource == null || resource.data.get('importId',null) == null
              ? !request.resource.data.keys().hasAny(['importId'])
              : request.resource.data.importId == resource.data.importId && getAfter(eventPath(request.resource.data.lastEventId)).data.schemaVersion == 6));
        allow delete: if false;
      }
    }
    // Friends have separate source streams and minimal, opt-in discovery profiles.
    function socialSignedIn() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function socialProfile(uid) { return /databases/$(database)/documents/friendProfiles/$(uid); }
    function socialPair(id) { return /databases/$(database)/documents/friendPairs/$(id); }
    function socialLink(uid, peer) { return /databases/$(database)/documents/friendLinks/$(uid)/peers/$(peer); }
    function socialUid(value) { return value is string && value.matches('^[^/]{1,128}$') && !(value in ['.','..']); }
    function socialName(value) { return value.trim().lower().replace('^@', ''); }
    function socialRelated(uid) {
      let link = socialLink(request.auth.uid, uid);
      return exists(link) && get(socialPair(get(link).data.pairId)).data.status in ['pending', 'accepted']
        && !get(socialPair(get(link).data.pairId)).data.blockedA && !get(socialPair(get(link).data.pairId)).data.blockedB;
    }
    function socialProfileEvent(uid, e, id) {
      return validId(id) && e.keys().hasOnly(['eventId','schemaVersion','sequence','recordedAt','type','actorUid','payload'])
        && e.eventId == id && e.actorUid == uid && e.schemaVersion == 1 && e.type == 'FriendProfileChosen' && e.recordedAt == request.time
        && e.payload.keys().hasOnly(['username','displayName','discoverable'])
        && e.payload.username is string && e.payload.username.size() <= 30 && socialName(e.payload.username).matches('^[a-z][a-z0-9_]{2,23}$')
        && e.payload.displayName is string && e.payload.displayName.size() <= 60 && e.payload.displayName.trim().size() > 0 && e.payload.discoverable is bool;
    }
    match /friendProfiles/{uid} {
      allow get: if socialSignedIn() && (request.auth.uid == uid || resource == null || resource.data.discoverable || socialRelated(uid));
      allow list, delete: if false;
      allow create, update: if owns(uid) && validProfileProjection(uid);
      function validProfileProjection(uid) {
        let n = request.resource.data;
        let event = /databases/$(database)/documents/friendProfiles/$(uid)/events/$(n.lastEventId);
        let e = validId(n.lastEventId) ? getAfter(event).data : {};
        return n.keys().hasOnly(['uid','username','displayName','discoverable','sequence','lastEventId'])
          && n.uid == uid && n.sequence == (resource == null ? 1 : resource.data.sequence + 1)
          && !exists(event) && socialProfileEvent(uid,e,n.lastEventId) && e.sequence == n.sequence
          && n.username == socialName(e.payload.username) && n.displayName == e.payload.displayName.trim() && n.discoverable == e.payload.discoverable
          && getAfter(/databases/$(database)/documents/friendUsernames/$(n.username)).data.uid == uid
          && (resource == null || resource.data.username == n.username || !existsAfter(/databases/$(database)/documents/friendUsernames/$(resource.data.username)));
      }
      match /events/{id} {
        allow read: if owns(uid);
        allow create: if owns(uid) && socialProfileEvent(uid,request.resource.data,id)
          && request.resource.data.sequence == (exists(socialProfile(uid)) ? get(socialProfile(uid)).data.sequence + 1 : 1)
          && getAfter(socialProfile(uid)).data.lastEventId == id;
        allow update, delete: if false;
      }
    }
    match /friendUsernames/{name} {
      allow get: if socialSignedIn() && (resource == null || resource.data.uid == request.auth.uid
        || get(socialProfile(resource.data.uid)).data.discoverable || socialRelated(resource.data.uid));
      allow list: if false;
      function newProfile(uid) {
        let n = getAfter(socialProfile(uid)).data;
        return !exists(/databases/$(database)/documents/friendProfiles/$(uid)/events/$(n.lastEventId));
      }
      allow create, update: if socialSignedIn() && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid
        && (resource == null || resource.data.uid == request.auth.uid) && newProfile(request.auth.uid)
        && getAfter(socialProfile(request.auth.uid)).data.username == name;
      allow delete: if socialSignedIn() && resource.data.uid == request.auth.uid && newProfile(request.auth.uid)
        && getAfter(socialProfile(request.auth.uid)).data.username != name;
    }
    match /friendLinks/{uid}/peers/{peer} {
      allow get: if socialSignedIn() && request.auth.uid in [uid,peer];
      allow list, update, delete: if false;
      allow create: if socialSignedIn() && request.auth.uid in [uid,peer] && uid != peer
        && request.resource.data.keys().hasOnly(['pairId']) && !exists(socialPair(request.resource.data.pairId))
        && getAfter(socialPair(request.resource.data.pairId)).data.members.toSet() == [uid,peer].toSet();
    }
    function socialInitial(members) {
      return {'members':members,'sequence':0,'lastEventId':null,'status':'none','requesterUid':null,'blockedA':false,'blockedB':false,'hugsA':true,'hugsB':true,'requestedAt':null,'lastHugA':null,'lastHugB':null};
    }
    function socialTransition(e,b,n) {
      let a = e.actorUid == b.members[0];
      let free = !b.blockedA && !b.blockedB;
      let common = ['sequence','lastEventId'];
      return (
        e.type == 'FriendRequestSent' && free && b.status == 'none'
          && (b.requestedAt == null || request.time >= b.requestedAt + duration.value(24,'h'))
          && exists(socialProfile(e.actorUid)) && get(socialProfile(e.targetUid)).data.discoverable
          && n.diff(b).affectedKeys().hasOnly(common.concat(['status','requesterUid','requestedAt']))
          && n.status == 'pending' && n.requesterUid == e.actorUid && n.requestedAt == request.time
        || e.type in ['FriendRequestAccepted','FriendRequestDeclined'] && free && b.status == 'pending' && b.requesterUid == e.targetUid
          && n.diff(b).affectedKeys().hasOnly(common.concat(['status','requesterUid'])) && n.requesterUid == null
          && n.status == (e.type == 'FriendRequestAccepted' ? 'accepted' : 'none')
        || e.type == 'FriendRequestCancelled' && b.status == 'pending' && b.requesterUid == e.actorUid
          && n.diff(b).affectedKeys().hasOnly(common.concat(['status','requesterUid'])) && n.status == 'none' && n.requesterUid == null
        || e.type == 'FriendRemoved' && b.status == 'accepted'
          && n.diff(b).affectedKeys().hasOnly(common.concat(['status','requesterUid'])) && n.status == 'none' && n.requesterUid == null
        || e.type == 'FriendBlocked' && !(a ? b.blockedA : b.blockedB)
          && n.diff(b).affectedKeys().hasOnly(common.concat(['status','requesterUid',a ? 'blockedA' : 'blockedB']))
          && n.status == 'none' && n.requesterUid == null && (a ? n.blockedA : n.blockedB)
        || e.type == 'FriendUnblocked' && (a ? b.blockedA : b.blockedB)
          && n.diff(b).affectedKeys().hasOnly(common.concat([a ? 'blockedA' : 'blockedB'])) && !(a ? n.blockedA : n.blockedB)
        || e.type == 'HugPreferencesChosen' && b.status == 'accepted' && e.payload.allowHugs is bool
          && n.diff(b).affectedKeys().hasOnly(common.concat([a ? 'hugsA' : 'hugsB'])) && (a ? n.hugsA : n.hugsB) == e.payload.allowHugs
        || e.type == 'HugSent' && free && b.status == 'accepted' && (a ? b.hugsB : b.hugsA)
          && ((a ? b.lastHugA : b.lastHugB) == null || request.time >= (a ? b.lastHugA : b.lastHugB) + duration.value(24,'h'))
          && n.diff(b).affectedKeys().hasOnly(common.concat([a ? 'lastHugA' : 'lastHugB'])) && (a ? n.lastHugA : n.lastHugB) == request.time
      );
    }
    match /friendPairs/{pairId} {
      allow get: if socialSignedIn() && (resource == null || request.auth.uid in resource.data.members);
      allow list: if socialSignedIn() && request.auth.uid in resource.data.members;
      allow delete: if false;
      allow create, update: if socialSignedIn() && validPairProjection();
      function validPairProjection() {
        let n = request.resource.data;
        let event = /databases/$(database)/documents/friendPairs/$(pairId)/events/$(n.lastEventId);
        let e = validId(n.lastEventId) ? getAfter(event).data : {};
        let b = resource == null ? socialInitial(n.members) : resource.data;
        return validId(pairId) && n.keys().hasOnly(b.keys()) && n.members == b.members && n.members is list && n.members.size() == 2 && n.members[0] != n.members[1] && socialUid(n.members[0]) && socialUid(n.members[1])
          && e.actorUid == request.auth.uid && e.targetUid == n.members[e.actorUid == n.members[0] ? 1 : 0] && request.auth.uid in n.members
          && n.sequence == b.sequence + 1 && e.sequence == n.sequence && !exists(event)
          && (resource != null || e.type in ['FriendRequestSent','FriendBlocked'] && n.members == [e.actorUid,e.targetUid]
            && exists(socialProfile(e.actorUid)) && exists(socialProfile(e.targetUid)))
          && getAfter(socialLink(n.members[0],n.members[1])).data.pairId == pairId
          && getAfter(socialLink(n.members[1],n.members[0])).data.pairId == pairId
          && socialTransition(e,b,n);
      }
      match /events/{id} {
        allow get: if socialSignedIn() && (resource == null || request.auth.uid in get(socialPair(pairId)).data.members);
        allow list: if socialSignedIn() && request.auth.uid in get(socialPair(pairId)).data.members;
        allow update, delete: if false;
        allow create: if socialSignedIn() && validPairEvent(id);
        function validPairEvent(id) {
          let e = request.resource.data;
          let n = getAfter(socialPair(pairId)).data;
          let before = exists(socialPair(pairId)) ? get(socialPair(pairId)).data : socialInitial(n.members);
          let p = e.payload;
          return validId(id) && e.keys().hasOnly(['eventId','schemaVersion','sequence','recordedAt','type','actorUid','targetUid','payload'])
            && e.eventId == id && e.schemaVersion == 1 && e.actorUid == request.auth.uid && e.recordedAt == request.time
            && request.auth.uid in n.members && e.targetUid == n.members[e.actorUid == n.members[0] ? 1 : 0]
            && e.sequence == before.sequence + 1 && n.lastEventId == id && n.sequence == e.sequence
            && p.previousEventId == before.lastEventId
            && p.keys().hasOnly(['previousEventId'].concat(e.type == 'HugPreferencesChosen' ? ['allowHugs'] : []));
        }
      }
    }
    // Reading a hug is a private recipient action, never a shared read receipt.
    match /friendInboxes/{uid} {
      allow read: if owns(uid);
      allow delete: if false;
      allow create, update: if owns(uid) && validInboxHead();
      function validInboxHead() {
        let n=request.resource.data;
        let source=/databases/$(database)/documents/friendInboxes/$(uid)/events/$(n.lastEventId);
        return n.keys().hasOnly(['sequence','lastEventId']) && validId(n.lastEventId) && !exists(source)
          && n.sequence==(resource==null?1:resource.data.sequence+1) && getAfter(source).data.sequence==n.sequence;
      }
      match /events/{id} {
        allow read: if owns(uid);
        allow update, delete: if false;
        allow create: if owns(uid) && validInboxEvent();
        function validInboxEvent() {
          let e=request.resource.data;
          let p=e.payload;
          let head=/databases/$(database)/documents/friendInboxes/$(uid);
          let hug=validId(p.pairId)&&validId(p.hugId)?get(/databases/$(database)/documents/friendPairs/$(p.pairId)/events/$(p.hugId)).data:{};
          return validId(id) && e.keys().hasOnly(['eventId','schemaVersion','type','actorUid','sequence','recordedAt','payload'])
            && e.eventId==id && e.schemaVersion==1 && e.type=='HugRead' && e.actorUid==uid && e.recordedAt==request.time
            && p.keys().hasOnly(['pairId','hugId']) && hug.type=='HugSent' && hug.targetUid==uid
            && e.sequence==(exists(head)?get(head).data.sequence+1:1)
            && getAfter(head).data.lastEventId==id && getAfter(head).data.sequence==e.sequence;
        }
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
